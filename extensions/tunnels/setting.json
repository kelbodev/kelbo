{
  "name": {
    "it": "Tunnel",
    "en": "Tunnels"
  },
  "code": "tunnels",
  "version": "1.0.0",
  "kelbo": "^2.0",
  "description": {
    "it": "Port forwarding per gruppi di server: SSH (ssh -L / autossh) e i trasporti delle estensioni (es. kubectl port-forward), con riconnessione automatica",
    "en": "Port forwarding for groups of servers: SSH (ssh -L / autossh) and the transports of the extensions (e.g. kubectl port-forward), with automatic reconnection"
  },
  "color": "#388bfd",
  "icon": "cable",
  "position": "tab",
  "order": 10,
  "config": [
    "groups",
    "servers"
  ],
  "export": [
    {
      "id": "tunnels",
      "label": {
        "it": "Tunnel SSH",
        "en": "SSH tunnels"
      },
      "description": {
        "it": "Gruppi e server",
        "en": "Groups and servers"
      },
      "sections": [
        "groups",
        "servers"
      ]
    }
  ],
  "backend": {
    "module": "server.js",
    "routes": [
      {
        "method": "GET",
        "path": "/state",
        "handler": "state"
      },
      {
        "method": "POST",
        "path": "/tunnels",
        "handler": "startTunnel"
      },
      {
        "method": "DELETE",
        "path": "/tunnels",
        "handler": "stopAll"
      },
      {
        "method": "DELETE",
        "path": "/tunnels/:id",
        "handler": "stopTunnel"
      },
      {
        "method": "GET",
        "path": "/tunnels/:id/logs",
        "handler": "tunnelLogs"
      },
      {
        "method": "POST",
        "path": "/transports/:id/fields",
        "handler": "transportFields"
      },
      {
        "method": "POST",
        "path": "/groups",
        "handler": "createGroup"
      },
      {
        "method": "PUT",
        "path": "/groups/:key",
        "handler": "updateGroup"
      },
      {
        "method": "DELETE",
        "path": "/groups/:key",
        "handler": "deleteGroup"
      },
      {
        "method": "POST",
        "path": "/servers",
        "handler": "createServer"
      },
      {
        "method": "PUT",
        "path": "/servers/:key",
        "handler": "updateServer"
      },
      {
        "method": "DELETE",
        "path": "/servers/:key",
        "handler": "deleteServer"
      }
    ]
  },
  "frontend": {
    "html": "view.html",
    "sidebar": "sidebar.html",
    "js": "view.js",
    "css": "style.css",
    "preload": true
  },
  "mcp": {
    "tools": [
      {
        "name": "list",
        "handler": "list",
        "readOnly": true,
        "description": "List the configured tunnels (local port; for SSH the remote host:port and the SSH alias, for other transports such as Kubernetes port-forward the transport and its target), their groups and which tunnels are currently connected.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ]
  },
  "widgets": [
    {
      "id": "project-tunnels",
      "title": {
        "it": "Tunnel SSH",
        "en": "SSH tunnels"
      },
      "description": {
        "it": "Tunnel usati dalle connessioni database del progetto, con connetti e disconnetti",
        "en": "Tunnels used by the project's database connections, with connect and disconnect"
      },
      "size": "s",
      "js": "widget.js"
    }
  ]
}
